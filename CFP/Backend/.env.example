NODE_ENV=production
PORT=5000
FRONTEND_URL=https://www.example.com

# Use a strong random value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRE=30d

# Optional local/demo seeding only. Do not reuse these in production.
SEED_ADMIN_PASSWORD=replace-with-local-admin-password
SEED_TRAINER_PASSWORD=replace-with-local-trainer-password
SEED_MEMBER_PASSWORD=replace-with-local-member-password

# cPanel MySQL values usually include your account prefix.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cpanelprefix_databaseuser
MYSQL_PASSWORD=replace-with-cpanel-mysql-user-password
MYSQL_DATABASE=cpanelprefix_databasename
MYSQL_CONNECTION_LIMIT=10

# Keep false unless your host explicitly requires MySQL SSL.
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Set true only while debugging cPanel environment variables in server logs.
DEBUG_ENV=false
