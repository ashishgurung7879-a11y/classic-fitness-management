{
  "name": "classic-fitness-park-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "Classic Fitness Park frontend",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "start": "vite --port 8080",
    "build": "vite build && node sync-live-server-assets.cjs",
    "build:web": "vite build && node sync-live-server-assets.cjs",
    "test": "node tests/homepage-regression.test.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "preview": "node dev-server.cjs --port 4173"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "vite": "^7.1.10"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.1"
  }
}
